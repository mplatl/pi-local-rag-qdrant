{
  "name": "pi-local-rag-qdrant",
  "version": "0.1.0",
  "description": "Hybrid RAG pipeline for the Pi coding agent backed by Qdrant. BM25 + vector embeddings + collections + auto-injection. Requires a local Qdrant instance.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "rag",
    "search",
    "bm25",
    "vector",
    "embeddings",
    "hybrid-search",
    "index",
    "qdrant",
    "collections",
    "local",
    "offline"
  ],
  "author": "kowsari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mplatl/pi-local-rag-qdrant.git"
  },
  "homepage": "https://github.com/mplatl/pi-local-rag-qdrant#readme",
  "bugs": {
    "url": "https://github.com/mplatl/pi-local-rag-qdrant/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.18.0",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.60.0"
  }
}
